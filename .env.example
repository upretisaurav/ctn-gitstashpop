# Copy to .env and fill in. Never commit or share this file.
CTN_TEAM_CODE=PASTE_YOUR_16_CHAR_TEAM_CODE
CTN_SIDE=yes
ANTHROPIC_API_KEY=sk-ant-...

# Spend cap per day for Claude (USD). $7/day ≈ $100 over the event.
CTN_DAILY_BUDGET_USD=7

# Start small, grow once it works (max 50 active, 200 total).
CTN_TARGET_ACTIVE=12

# Safety switches
CTN_DRY_RUN=false
CTN_OBSERVE_ONLY=false
